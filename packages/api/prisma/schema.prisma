generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

enum ArtifactType {
  INTENTS
  PLAN
  EVAL
  EVAL_ITEM

  PROMPT
  PROMPT_POLICY
  QUALITY_METRICS

  HINT
  SUMMARY
  OUTLINE
  INTENTS
  PLAN
  PROMPT
  HINT
  QUALITY_METRICS
  OTHER
}

enum ReviewVerdict {
  APPROVED
  REJECTED
  NEEDS_REVISION
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  isAdmin  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents    Document[]
  subjects     Subject[]
  evals        Eval[]
  testAttempts TestAttempt[]
  artifacts    Artifact[]
  reviews      EvalItemReview[]
}

model Subject {
  id          String  @id @default(uuid())
  name        String
  description String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  evals     Eval[]
}

model Document {
  id       String  @id @default(uuid())
  filename String
  title    String?
  mimeType String?
  content  String? @db.Text

  storagePath String?
  ragStatus   String  @default("PENDING")

  userId String
  user   User   @relation(fields: [userId], references: [id])

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  artifacts Artifact[]
}

model Eval {
  id String @id @default(uuid())

  title       String
  description String?
  status      String  @default("draft") // draft, published, archived

  difficulty   String?
  instructions String? @db.Text
  rubric       Json?

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items     EvalItem[]
  attempts  TestAttempt[]
  artifacts Artifact[]
}

model EvalItem {
  id String @id @default(uuid())

  evalId String
  eval   Eval   @relation(fields: [evalId], references: [id], onDelete: Cascade)

  prompt     String   @db.Text
  options    String[]
  correctIdx Int

  hint        String?
  explanation String?
  metadata    Json?

  userAnswers UserAnswer[]
  artifacts   Artifact[]
  reviews     EvalItemReview[]
}

model PromptTemplate {
  id String @id @default(uuid())

  key         String  @unique
  version     Int     @default(1)
  isActive    Boolean @default(false)
  title       String
  description String?

  template String @db.Text
  metadata Json?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, version])
  @@index([key, isActive])
}

model TestAttempt {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  evalId String
  eval   Eval   @relation(fields: [evalId], references: [id])

  score      Int     @default(0)
  total      Int
  percentage Float?
  totalTime  Int?
  feedback   Json?
  summary    String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  answers   UserAnswer[]
  artifacts Artifact[]
}

model UserAnswer {
  id String @id @default(uuid())

  attemptId String
  attempt   TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  evalItemId String
  evalItem   EvalItem @relation(fields: [evalItemId], references: [id])

  selectedIdx Int
  isCorrect   Boolean
  timeSpent   Int?
  hintsUsed   Int     @default(0)

  createdAt DateTime @default(now())
}

model EvalItemReview {
  id String @id @default(uuid())

  evalItemId String
  evalItem   EvalItem @relation(fields: [evalItemId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User   @relation(fields: [reviewerId], references: [id])

  isCorrect   Boolean
  feedback    String? @db.Text
  difficulty  String? // easy, medium, hard
  quality     Int?    // 1-5 rating
  tags        String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([evalItemId, reviewerId])
}

model Artifact {
  id String @id @default(uuid())

  type   ArtifactType
  status String       @default("READY")

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)

  evalId String?
  eval   Eval?   @relation(fields: [evalId], references: [id], onDelete: Cascade)

  evalItemId String?
  evalItem   EvalItem? @relation(fields: [evalItemId], references: [id], onDelete: Cascade)

  attemptId String?
  attempt   TestAttempt? @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  text String?
  json Json?

  model     String?
  prompt    String?
  inputHash String?
  meta      Json?
  error     String?

  createdAt DateTime @default(now())

  @@index([type])
}

model PromptTemplate {
  id String @id @default(uuid())

  key     String // "eval_generation", "hint_generation"
  version String
  status  String // active | deprecated | draft

  template     String  @db.Text
  constraints  Json?
  outputSchema String?

  createdAt DateTime @default(now())

  @@unique([key, version])
}

model EvalItemReview {
  id String @id @default(uuid())

  evalItemId String
  evalItem   EvalItem @relation(fields: [evalItemId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User   @relation(fields: [reviewerId], references: [id])

  verdict  ReviewVerdict
  reasons  String[]
  comments String?

  createdAt DateTime @default(now())
}
