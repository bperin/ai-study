generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  isAdmin   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects     Subject[]
  documents    Document[]
  evalSessions EvalSession[]
  evals        Eval[]
  testAttempts TestAttempt[]
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  description String?
  storeId     String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  evals     Eval[]
}

model Document {
  id          String   @id @default(uuid())
  filename    String
  title       String?
  mimeType    String?
  content     String? @db.Text

  storagePath String?
  ragFileName String?
  ragStatus   String @default("PENDING")
  storeId     String?
  fileId      String?

  userId    String
  user      User    @relation(fields: [userId], references: [id])

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evals Eval[]
}

model Eval {
  id String @id @default(uuid())

  title       String
  description String?
  status      String @default("draft")

  difficulty   String?
  instructions String? @db.Text
  rubric       Json?

  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])

  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    EvalItem[]
  attempts TestAttempt[]
  sessions EvalSession[]
}

model EvalItem {
  id String @id @default(uuid())

  evalId String
  eval   Eval   @relation(fields: [evalId], references: [id])

  type   String
  prompt String @db.Text

  options    String[]
  correctIdx Int?

  hasImage    Boolean @default(false)
  imageUrl    String?
  imagePrompt String?

  hint        String?
  explanation String?

  metadata Json?

  testResponses TestResponse[]
}

model EvalSession {
  id String @id @default(uuid())

  evalId String
  eval   Eval   @relation(fields: [evalId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  userPreferences Json
  proposedPlan    Json?
  planStatus      String @default("pending")
  iterationCount  Int    @default(0)

  difficulty    String?
  totalItems    Int?
  includeImages Boolean @default(false)
  imageCount    Int     @default(0)
  timeLimitMins Int?

  status String @default("planning")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestAttempt {
  id String @id @default(uuid())

  evalId String
  eval   Eval   @relation(fields: [evalId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status String @default("in_progress")

  score      Float?
  maxScore   Float?
  percentage Float?

  startedAt   DateTime @default(now())
  completedAt DateTime?
  durationSec Int?

  feedback Json?
  summary  String? @db.Text

  responses TestResponse[]
}

model TestResponse {
  id String @id @default(uuid())

  testAttemptId String
  testAttempt   TestAttempt @relation(fields: [testAttemptId], references: [id])

  evalItemId String
  evalItem   EvalItem @relation(fields: [evalItemId], references: [id])

  response   Json
  isCorrect  Boolean?

  timeSpentSec Int  @default(0)
  hintsUsed    Int  @default(0)
  confidence   Int?

  createdAt DateTime @default(now())
}
