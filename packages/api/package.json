{
    "name": "@memorang/api",
    "version": "1.0.0",
    "scripts": {
        "clean": "rm -rf dist coverage openapi.json packages",
        "prisma": "prisma db push && prisma generate",
        "build": "nest build",
        "build:watch": "nest build --watch",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "node dist/main.js",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "dev:fast": "ts-node -r tsconfig-paths/register src/main.ts",
        "dev:hot": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
        "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
        "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
        "test": "jest --passWithNoTests",
        "test:unit": "jest --testPathPattern=\\.spec\\.ts$ --passWithNoTests",
        "test:integration": "jest --testPathPattern=\\.integration\\.spec\\.ts$ --passWithNoTests",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "generate:openapi": "npx ts-node -r dotenv/config scripts/generate-openapi.ts"
    },
    "dependencies": {
        "@google-cloud/storage": "^7.18.0",
        "@google/genai": "^1.32.0",
        "@nestjs/bullmq": "^10.2.1",
        "@nestjs/common": "^10.4.20",
        "@nestjs/config": "^3.0.0",
        "@nestjs/core": "^10.4.20",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.1",
        "@nestjs/platform-express": "^10.4.20",
        "@nestjs/platform-socket.io": "^10.4.20",
        "@nestjs/swagger": "^7.1.0",
        "@nestjs/websockets": "^10.4.20",
        "@opentelemetry/api": "^1.9.0",
        "@prisma/adapter-pg": "^7.1.0",
        "@prisma/client": "^7.1.0",
        "@types/bcrypt": "^6.0.0",
        "bcrypt": "^6.0.0",
        "bullmq": "^5.66.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.0",
        "dotenv": "^17.2.3",
        "ioredis": "^5.8.2",
        "nest-winston": "^1.10.2",
        "passport-jwt": "^4.0.1",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.0",
        "socket.io": "^4.8.1",
        "swagger-ui-express": "^5.0.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "winston": "^3.19.0",
        "zod": "^3.25.76",
        "zod-to-json-schema": "^3.25.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/schematics": "^10.2.3",
        "@nestjs/testing": "^10.4.20",
        "@types/express": "^4.17.0",
        "@types/jest": "^29.5.14",
        "@types/multer": "^1.4.0",
        "@types/node": "^20.0.0",
        "@types/pg": "^8.16.0",
        "@types/supertest": "^2.0.0",
        "@typescript-eslint/eslint-plugin": "^8.10.0",
        "@typescript-eslint/parser": "^8.10.0",
        "eslint": "^8.0.0",
        "jest": "^29.7.0",
        "prettier": "^3.0.0",
        "prisma": "^7.1.0",
        "source-map-support": "^0.5.0",
        "supertest": "^6.0.0",
        "ts-jest": "^29.4.6",
        "ts-loader": "^9.0.0",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.0.0"
    }
}
